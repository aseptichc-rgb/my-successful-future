    <!-- 네이티브 결제 브릿지(PurchaseBridgeActivity) 실패 안내 Toast -->
    <string name="purchase_error_sign_in_required">로그인 정보를 확인할 수 없어 결제를 진행하지 못했습니다. 앱을 다시 열고 시도해 주세요.</string>
    <string name="purchase_error_product_unavailable">상품 정보를 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.</string>
    <string name="purchase_error_launch_failed">결제 화면을 열지 못했습니다. 잠시 후 다시 시도해 주세요.</string>
    <string name="purchase_error_verify_failed">결제 확인에 실패했습니다. 이미 결제하셨다면 \'구매 복원\'을 눌러 주세요.</string>
    <string name="purchase_error_generic">결제 처리 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.</string>

    <!-- 저녁 기록 알림 (기본 21:00, 기기 타임존 — 시각·on/off 는 앱 설정을 따름) -->
    <string name="wins_reminder_channel_name">저녁 기록 알림</string>
    <string name="wins_reminder_channel_description">저녁에 오늘의 목표와 잘한 일을 기록하도록 알려드려요. 이미 체크한 날은 보내지 않아요.</string>
    <string name="wins_reminder_title">오늘의 목표, 아직 남아 있어요</string>
    <string name="wins_reminder_body">잠깐이면 돼요 — 오늘 한 걸음을 체크해 주세요.</string>
    <!-- 오늘의 목표 문구를 실을 수 있을 때의 본문 변형 -->
    <string name="wins_reminder_body_goal">잠깐이면 돼요 — "%1$s" 를 체크해 주세요.</string>

    <!-- 다짐 따라쓰기 아침 알림 (기본 08:00, 기기 타임존 — 시각·on/off 는 앱 설정을 따름) -->
    <string name="affirmations_reminder_channel_name">꿈에 한 발 더 알림</string>
    <string name="affirmations_reminder_channel_description">아침에 \"꿈을 이룬 나\" 다짐을 따라 적어보도록 알려드려요.</string>
    <string name="affirmations_reminder_title">꿈에 한 발 더</string>
    <string name="affirmations_reminder_body">꿈을 이룬 나의 선언을 따라 적으며 하루를 시작해요.</string>

    <!-- 일요일 주간 회고 알림 (저녁 시각에 기록 알림 대신 도착) -->
    <string name="weekly_review_channel_name">주간 회고 알림</string>
    <string name="weekly_review_channel_description">일요일 저녁, 한 주를 돌아보도록 알려드려요.</string>
    <string name="weekly_review_title">이번 주를 돌아볼 시간</string>
    <string name="weekly_review_body">일주일의 기록이 정리됐어요. 잠깐 돌아보세요.</string>

    <!--
      미완 과업 넛지 (오늘 할 일을 다 해 저녁 알림이 침묵하는 날의 빈 슬롯, 주 2회까지).
      제목/본문은 서버가 사용자 언어로 조립해 내려주므로 여기엔 채널 라벨만 둔다 —
      무엇이 밀렸는지 모르는 채로 보내는 폴백 문구는 두지 않는다(무엇을 하라는 건지 알 수 없다).
    -->
    <string name="pending_task_channel_name">남은 과업 알림</string>
    <string name="pending_task_channel_description">오늘 할 일을 다 한 날 저녁에만, 아직 채우지 않은 것 하나를 조용히 알려드려요.</string>
