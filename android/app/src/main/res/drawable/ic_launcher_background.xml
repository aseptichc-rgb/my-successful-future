<?xml version="1.0" encoding="utf-8"?>
<!--
  Anima 런처 아이콘 배경 — anima_indigo 단일 톤 그라데이션.
  · linear-gradient(135deg, #1E1B4B 0%, #15123A 100%)
  · 기존 soul 오렌지에서 인디고로 전환 — 위젯/홈 배경의 indigo 본문 색과 톤 일치.
  · ShapeDrawable 의 gradient angle 은 좌측에서 시계방향이고 8 방향 단위라
    135deg(좌상→우하 디자인) 와 시각적으로 동일하려면 angle=315 (좌상이 밝고 우하가 어두움).
  · 로그인 화면 LogoLockup 사각형(soul 오렌지) 과 더 이상 동색이 아님 — 의도된 디자인 분리.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1E1B4B"
        android:endColor="#15123A" />
</shape>
