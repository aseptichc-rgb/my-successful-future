<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 글래스 패널 (라이트 톤) — 백엔드가 gradient.tone="light" 를 보낼 때. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/widget_glass_top_light"
        android:endColor="@color/widget_glass_bottom_light" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_glass_stroke_light" />
</shape>
