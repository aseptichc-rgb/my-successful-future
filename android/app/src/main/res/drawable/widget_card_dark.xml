<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 글래스 패널 (다크 톤).
  RemoteViews 라 backdrop blur 가 불가능하므로, 우주 배경화면 위에서
  "프로스트 글래스" 로 읽히도록 반투명 딥 네이비 그라데이션 + 1px 화이트 테두리로 마감.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/widget_glass_top"
        android:endColor="@color/widget_glass_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_glass_stroke" />
</shape>
