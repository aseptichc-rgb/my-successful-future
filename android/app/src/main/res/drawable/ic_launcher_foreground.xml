<?xml version="1.0" encoding="utf-8"?>
<!--
  Anima 런처 아이콘 전경(foreground) — design/Anima Logo Directions.html 의
  캐논 Aperture 기하 + Comet 권장 "이중 코어" 패턴.
  · 108dp 뷰포트의 안전영역(중앙 72dp)을 거의 채우도록 r=30.
  · gap=18°, 중심각 -90° (12시)
      시작각 gapEnd=-81° → (54+30·cos(-81°), 54+30·sin(-81°)) ≈ (58.69, 24.36)
      끝각  gapStart+360=261° → (54+30·cos(261°), 54+30·sin(261°)) ≈ (49.31, 24.36)
  · 중심 코어: soul 오렌지 단일 점(r=3) — 흰 외환을 제거하고 위젯 로고
      (ic_anima_aperture) / 웹 파비콘 / app/icon.svg 와 똑같이 "호 + 주황 점"
      으로 통일. 기존 이중 코어는 홈 화면 작게 볼 때 흰 점처럼 보여 주황이
      드러나지 않던 문제를 해결 — 어디서 만나든 같은 마크임을 즉시 인지.
      (canonical 비례: 위젯 r=3.6 @arc 42 → launcher arc 30 → r≈2.6, 어두운
       indigo 배경 + 작은 런처 크기 가독성 위해 r=3 으로 소폭 키움.)
  · stroke 2.8 — 36dp 이하 launcher 에서 호가 가늘게 깨지는 현상 보강.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- aperture 원호 (12시 방향이 살짝 열려있음) -->
    <path
        android:pathData="M 58.69 24.36 A 30 30 0 1 1 49.31 24.36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- 중심 코어 — soul 오렌지 단일 점 (r=3) — 위젯/파비콘과 동일한 "심장".
         indigo 배경 위 따뜻한 soul 오렌지가 brand identity 의 핵심. -->
    <path
        android:fillColor="#D85A30"
        android:pathData="M 54 51 a 3 3 0 1 0 0 6 a 3 3 0 1 0 0 -6 Z" />
</vector>
