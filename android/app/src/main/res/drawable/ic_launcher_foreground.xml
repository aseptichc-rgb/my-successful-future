<?xml version="1.0" encoding="utf-8"?>
<!--
  Anima 런처 아이콘 전경(foreground) — design/Anima Logo Directions.html 의
  캐논 Aperture 기하 + Comet 권장 "이중 코어" 패턴.
  · 108dp 뷰포트의 안전영역(중앙 72dp)을 거의 채우도록 r=30.
  · gap=18°, 중심각 -90° (12시)
      시작각 gapEnd=-81° → (54+30·cos(-81°), 54+30·sin(-81°)) ≈ (58.69, 24.36)
      끝각  gapStart+360=261° → (54+30·cos(261°), 54+30·sin(261°)) ≈ (49.31, 24.36)
  · 중심 이중 코어: 흰 외환(r=4) + soul 오렌지 내핵(r=1.8).
      웹 파비콘 / app/icon.svg / 로그인 LogoLockup 의 "indigo 호 + soul 오렌지 점"
      과 동일한 무게로 통일 — 어디서 만나든 같은 마크임을 즉시 인지.
  · stroke 2.8 — 36dp 이하 launcher 에서 호가 가늘게 깨지는 현상 보강.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- aperture 원호 (12시 방향이 살짝 열려있음) -->
    <path
        android:pathData="M 58.69 24.36 A 30 30 0 1 1 49.31 24.36"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />

    <!-- 중심 코어 — 흰 외환 (r=4) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54 50 a 4 4 0 1 0 0 8 a 4 4 0 1 0 0 -8 Z" />

    <!-- 중심 코어 — soul 오렌지 내핵 (r=1.8) — 인디고 배경 + 흰 외환 위에서
         따뜻한 soul 오렌지 점이 brand identity 의 "심장" 역할. -->
    <path
        android:fillColor="#D85A30"
        android:pathData="M 54 52.2 a 1.8 1.8 0 1 0 0 3.6 a 1.8 1.8 0 1 0 0 -3.6 Z" />
</vector>
