<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 선택기(picker)에 보이는 미리보기 — v2 "신호판" 디자인.
  serif italic 인용문 + mono uppercase 메타 + hairline divider.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- 헤더: Anima 로고 + 워드마크 + 진척도 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_anima_aperture"
            android:contentDescription="Anima" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:fontFamily="serif"
            android:textStyle="normal"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:text="Anima" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent_soul"
            android:textSize="11sp"
            android:text="1 / 3 OK" />
    </LinearLayout>

    <!-- 인용문 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/widget_ink"
        android:textSize="16sp"
        android:textStyle="italic"
        android:fontFamily="serif"
        android:text="오늘 너의 한 걸음이\n10년 뒤의 내 모습을 만들었어." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_ink"
        android:alpha="0.36"
        android:fontFamily="monospace"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textSize="10sp"
        android:gravity="end"
        android:text="— 10년 후의 나" />

    <!--
      Hairline divider. AppWidget 레이아웃은 RemoteViews 화이트리스트만 허용하므로
      순수 View 대신 FrameLayout(허용됨)으로 1dp 라인을 그린다.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@color/widget_hairline_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_check_done"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/widget_ink"
            android:alpha="0.36"
            android:textSize="13sp"
            android:text="성공한 나에게 한 발 더" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_check_todo"
            android:contentDescription="@null"
            android:alpha="0.28" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:text="목표를 이루기 위한 오늘의 행동" />
    </LinearLayout>
</LinearLayout>
