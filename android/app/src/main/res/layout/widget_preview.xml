<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 선택기(picker)에 보이는 미리보기 — 실제 글래스 디자인과 톤을 맞춘다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_dark"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_dark"
        android:alpha="0.20"
        android:textSize="34sp"
        android:textStyle="bold"
        android:text="“" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_dark"
        android:textSize="15sp"
        android:text="오늘 너의 한 걸음이\n10년 뒤의 내 모습을 만들었어." />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_text_dark"
        android:alpha="0.62"
        android:textSize="10sp"
        android:gravity="end"
        android:text="— 10년 후의 나" />

    <!--
      구분선. AppWidget 레이아웃은 시스템/런처가 RemoteViews 제한 인플레이터로 그리므로
      @RemoteView 화이트리스트 뷰만 허용된다. 순수 android.view.View 는 불가 —
      넣으면 "Class not allowed to be inflated" 로 미리보기·위젯 추가가 통째로 실패한다.
      그래서 1dp 라인은 FrameLayout(허용됨)으로 그린다.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#24FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">
        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_widget_check_done"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text_dark"
            android:alpha="0.50"
            android:textSize="12sp"
            android:text="성공한 나에게 한 발 더" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_row_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp">
        <ImageView
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:src="@drawable/ic_widget_check_todo"
            android:contentDescription="@null"
            android:alpha="0.72" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/widget_text_dark"
            android:alpha="0.92"
            android:textSize="12sp"
            android:text="목표를 이루기 위한 오늘의 행동" />
    </LinearLayout>
</LinearLayout>
