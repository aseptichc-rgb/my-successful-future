<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Play Billing — 네이티브 BillingClient(PurchaseBridgeActivity) 인앱 결제를 위한 권한. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      광고 ID 권한 차단 — 앱은 광고를 표시하지 않고 광고 ID 를 수집하지 않는다.
      Play services 계열 SDK 가 라이브러리 매니페스트에서 자동 병합하더라도 명시적으로 제거해
      Data Safety("광고 ID 미수집") 와 실제 권한을 일치시킨다.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".AnimaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anima"
        tools:targetApi="36"
        xmlns:tools="http://schemas.android.com/tools">

        <!-- Trusted Web Activity 가 신뢰 도메인을 검증할 때 참조. assetlinks.json 과 SHA-256 이 매칭되어야 주소창이 사라진다. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Anima">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          anima://auth?token=<customToken>
          웹(TWA) 로그인 세션을 네이티브 FirebaseAuth 로 옮기는 브릿지 딥링크 전용.
          NoDisplay 테마 + noHistory 로 어떤 UI 도 그리지 않고 처리 후 즉시 사라짐 —
          TWA 위에 빈 화면이 깜빡이는 회귀를 차단한다.
          BROWSABLE 카테고리가 있어야 Chrome/Custom Tabs 안에서 발화한 intent 도 라우팅된다.
        -->
        <activity
            android:name=".AuthBridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anima" android:host="auth" />
            </intent-filter>
        </activity>

        <!--
          anima://widget-refresh
          웹(TWA) 안에서 다짐/행동/잘한 일 저장 직후 위젯을 즉시 갱신하기 위한 브릿지 딥링크.
          NoDisplay + noHistory + excludeFromRecents 로 TWA 위에 어떤 UI 도 그리지 않는다.
          BROWSABLE 카테고리가 있어야 Chrome/Custom Tabs 안에서 발화한 intent 가 라우팅된다.
        -->
        <activity
            android:name=".WidgetRefreshBridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anima" android:host="widget-refresh" />
            </intent-filter>
        </activity>

        <!--
          anima://signout
          웹(TWA) 안에서 로그아웃 직후 네이티브 세션 · 위젯 캐시를 함께 비우기 위한 브릿지 딥링크.
          NoDisplay + noHistory + excludeFromRecents 로 TWA 위에 어떤 UI 도 그리지 않는다.
          BROWSABLE 카테고리가 있어야 Chrome/Custom Tabs 안에서 발화한 intent 가 라우팅된다.
        -->
        <activity
            android:name=".SignOutBridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anima" android:host="signout" />
            </intent-filter>
        </activity>

        <!--
          anima://purchase  (옵션 ?mode=restore)
          웹(TWA) 결제 버튼이 발화하는 네이티브 결제 브릿지. TWA 웹 Digital Goods 위임이 Android 13+
          에서 clientAppUnavailable 로 깨지므로, 결제만 네이티브 BillingClient 로 직접 처리한다.
          Translucent 테마(자체 UI 없이 Play 결제 시트만 위에 뜸) + noHistory 미사용
          (결제 시트가 닫혀 콜백이 올 때까지 액티비티가 살아 있어야 함).
          BROWSABLE 카테고리가 있어야 Chrome/Custom Tabs 안에서 발화한 intent 가 라우팅된다.
        -->
        <activity
            android:name=".PurchaseBridgeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anima" android:host="purchase" />
            </intent-filter>
        </activity>

        <!--
          TWA 위임 서비스 — Chrome 이 TRUSTED_WEB_ACTIVITY_SERVICE 로 바인딩(웹 알림 위임 등).
          NOTE: 과거 여기 있던 Play Billing 위임(androidbrowserhelper:billing 의 PaymentActivity/
          PaymentService/DigitalGoodsRequestHandler)은 제거됨 — 결제는 네이티브 BillingClient
          (PurchaseBridgeActivity)가 전담하며, 위임 라이브러리(1.1.0)가 Play Billing 8.0.0+ 요구사항을
          충족하지 못해 함께 삭제했다. (자세한 사유는 AnimaDelegationService 주석 참고.)
        -->
        <service
            android:name=".AnimaDelegationService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Glance 위젯 리시버 -->
        <receiver
            android:name=".widget.QuoteWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>
    </application>
</manifest>
