# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
/.tmp_screenshots/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev.log
.next-dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase service account key
*-firebase-adminsdk-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling artifacts
.claude/
.playwright-mcp/
test-results/
playwright-report/

# 임시 스크린샷 (UI 디버깅용)
desktop-view.png
mobile-view.png

# 로컬 보관용 안드로이드 APK
*.apk

# 디자인 패치 원본 자료 (이미 코드에 적용됨 — 원본 zip·중복 파일은 로컬에만 보존)
/motivator.zip
/patch/
/design.zip
/design/

# IDE 로컬 설정 — 개인 워크스페이스 상태, 커밋 대상 아님
/.idea/
